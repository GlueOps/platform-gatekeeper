PORT=8080
KUBECONFIG=${HOME}/.kube/config

# How often to re-evaluate every Gate. 0 disables the reconcile loop.
GATEKEEPER_RECONCILE_INTERVAL=30s

GATEKEEPER_GATE_GROUP=platform.glueops.dev
GATEKEEPER_GATE_VERSION=v1alpha2
GATEKEEPER_GATE_RESOURCE=gates

# Which namespaces a platform-mode Gate may read from. Both are empty by default,
# which means no cross-namespace access at all.
GATEKEEPER_PLATFORM_ALLOWED_NAMESPACES="glueops-core"
GATEKEEPER_PLATFORM_ALLOWED_NAMESPACE_PREFIXES="glueops-core-"
